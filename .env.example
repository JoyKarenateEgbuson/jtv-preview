# Copy to .env.local for local work. In production, set these in your host's dashboard.

# --- Required ---
# Password for the admin dashboard (/admin)
ADMIN_PASSWORD=
# Long random string used to sign sessions and viewer tokens
SESSION_SECRET=
# Name shown on your own comments and admin watermark preview
ADMIN_NAME=The Joie TV

# --- Google Drive (video storage, uses your own Drive space) ---
# Leave blank to store videos on this computer (dev mode).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Firestore (comments, clients, links) ---
# Leave blank to use a local JSON file (dev mode).
# Service account key JSON, base64-encoded (see docs/SETUP.md).
GOOGLE_SERVICE_ACCOUNT_JSON=
